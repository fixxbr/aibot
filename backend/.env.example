# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Neon pooled connection string for a dedicated "fixera" database, e.g.
# postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/fixera?sslmode=require&channel_binding=require
# Leave empty in local development to use an embedded database in ./data/pglite.
DATABASE_URL=
# JWT shared with FixBridge auth (HS256). Fixera verifies tokens; it never issues them in production.
FIXERA_JWT_SECRET=change-me
# FIXERA_JWT_ISSUER=
# FIXERA_JWT_AUDIENCE=
# Origins of the existing site allowed to call this API when it runs on a separate domain.
CORS_ORIGINS=https://fixbridge.us,https://www.fixbridge.us
# Seed demo users/properties and print dev tokens on boot (never in production).
FIXERA_SEED_DEMO=false

# --- Media (private object storage) ------------------------------------------
# local (dev only) | s3 (S3, Cloudflare R2, MinIO; requires `npm i @aws-sdk/client-s3`)
MEDIA_DRIVER=local
MEDIA_LOCAL_DIR=./data/media
MEDIA_MAX_BYTES=10485760
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- AI providers (keys stay server-side) ------------------------------------
# Tried in this order; admins can reorder/disable at /api/fixera/admin/providers.
FIXERA_PROVIDER_ORDER=openrouter,anthropic,openai,gemini
FIXERA_PROVIDER_TIMEOUT_MS=120000
# Allow a text-only model for cases with photos (result is marked "not visually analyzed").
FIXERA_ALLOW_TEXT_ONLY_FALLBACK=false
# Comma-separated model IDs that cannot read images.
FIXERA_TEXT_ONLY_MODELS=

# OpenRouter (OpenAI-compatible gateway). Use a vision-capable model slug from openrouter.ai/models.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Anthropic Claude (official SDK). Server-side refusal fallback is on by default.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high
ANTHROPIC_SERVER_FALLBACKS=true

OPENAI_API_KEY=
OPENAI_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=

# USD per million tokens, used only for cost logging.
FIXERA_MODEL_PRICES={"claude-opus-5-5":{"in":4,"out":20}}

# --- Knowledge Base retrieval ------------------------------------------------
# none = PostgreSQL full-text search; openai = add pgvector semantic search (needs OPENAI_API_KEY)
FIXERA_EMBEDDINGS=none

# --- Limits ------------------------------------------------------------------
FIXERA_ANALYSIS_RATE_LIMIT_PER_HOUR=30
FIXERA_MAX_HISTORY_MESSAGES=40
FIXERA_MAX_KNOWLEDGE_CHUNKS=6
